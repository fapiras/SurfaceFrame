<Window x:Class="SurfaceFrame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Surface Frame" Width="900" Height="600" WindowStyle="None" ResizeMode="NoResize"
        Background="Black" FontFamily="Segoe UI" ShowInTaskbar="True" WindowStartupLocation="Manual">
    <Grid x:Name="SurfaceRoot">
        <Grid x:Name="HomeLayer" Visibility="Hidden">
            <Grid x:Name="BrowserHost" Background="{StaticResource Canvas}" Visibility="Hidden" />
            <Border x:Name="HomeMessage" Visibility="Collapsed" Background="{StaticResource Panel}" CornerRadius="18"
                    Padding="32" Margin="24" MaxWidth="540"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Home Assistant" Foreground="{StaticResource Text}" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock x:Name="HomeStatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               FontSize="16" LineHeight="24" Margin="0,10,0,18" />
                    <WrapPanel>
                        <Button x:Name="RetryButton" Style="{StaticResource Action}" Content="Riprova"
                                Click="RetryHome_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Action}" Content="Impostazioni" Click="Settings_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="PhotoLayer" Background="Black" ClipToBounds="True"
              PreviewTouchDown="Photo_TouchDown" MouseLeftButtonUp="Photo_MouseUp">
            <Image x:Name="BackPhoto" Stretch="UniformToFill" />
            <Image x:Name="FrontPhoto" Stretch="UniformToFill" />
            <Border x:Name="EmptyFrame" Background="{StaticResource Canvas}" Padding="32">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock Text="Surface Frame" Foreground="{StaticResource Text}" FontSize="32"
                               TextAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock x:Name="FrameStatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               TextAlignment="Center" FontSize="16" LineHeight="24" Margin="0,12,0,20" />
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Style="{StaticResource Action}" Content="Aggiorna foto" Click="RetryPhotos_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Action}" Content="Impostazioni" Click="Settings_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Border x:Name="PhotoInfoPanel" Style="{StaticResource FloatingPanel}" Visibility="Collapsed"
                IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16"
                MaxWidth="580" Padding="13,8">
            <TextBlock x:Name="PhotoInfo" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
        </Border>
        <Border x:Name="NightDim" Background="#99000000" IsHitTestVisible="False" Visibility="Collapsed" />
        <Button x:Name="NightBlack" Background="Black" Foreground="Black" Visibility="Collapsed" Click="Wake_Click"
                AutomationProperties.Name="Riattiva lo schermo">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Popup x:Name="CommandPopup" Placement="Custom" PlacementTarget="{Binding ElementName=SurfaceRoot}"
               AllowsTransparency="True" StaysOpen="True">
            <StackPanel>
                <Border x:Name="CommandMenu" Style="{StaticResource FloatingPanel}" Visibility="Collapsed"
                        Padding="8" Margin="0,0,0,8" Width="244">
                    <StackPanel>
                        <Button x:Name="SwitchModeButton" Style="{StaticResource MenuAction}" Click="SwitchMode_Click"
                                Content="Home Assistant" />
                        <StackPanel x:Name="SlideControls">
                            <Button x:Name="PreviousButton" Style="{StaticResource MenuAction}" Content="Foto precedente" Click="Previous_Click" />
                            <Button x:Name="PauseButton" Style="{StaticResource MenuAction}" Content="Pausa presentazione" Click="Pause_Click" />
                            <Button x:Name="NextButton" Style="{StaticResource MenuAction}" Content="Foto successiva" Click="Next_Click" />
                        </StackPanel>
                        <Button Style="{StaticResource MenuAction}" Content="Impostazioni" Click="Settings_Click" />
                        <Button Style="{StaticResource MenuAction}" Content="Desktop Windows" Click="Windows_Click" />
                        <Button Style="{StaticResource MenuAction}" Content="Minimizza" Click="Minimize_Click" />
                        <Button Style="{StaticResource MenuAction}" Content="Chiudi Surface Frame" Click="Exit_Click" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FloatingPanel}" HorizontalAlignment="Right" Padding="3">
                    <Button x:Name="CommandButton" Style="{StaticResource Action}" Content="Comandi"
                            Click="Commands_Click" AutomationProperties.Name="Comandi di Surface Frame" />
                </Border>
            </StackPanel>
        </Popup>
    </Grid>
</Window>

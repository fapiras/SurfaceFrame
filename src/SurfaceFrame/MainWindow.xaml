<Window x:Class="SurfaceFrame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Surface Frame" Width="900" Height="600" WindowStyle="None" ResizeMode="NoResize"
        Background="Black" FontFamily="Segoe UI" ShowInTaskbar="True" WindowStartupLocation="Manual">
    <Grid>
        <Grid x:Name="HomeLayer" Visibility="Hidden">
            <Grid x:Name="BrowserHost" Background="#111820" />
            <Border x:Name="HomeMessage" Visibility="Collapsed" Background="#18212A" CornerRadius="18"
                    Padding="32" Margin="24,24,24,96" MaxWidth="540"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Home Assistant" Foreground="{StaticResource Text}" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock x:Name="HomeStatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               FontSize="16" LineHeight="24" Margin="0,10,0,18" />
                    <WrapPanel>
                        <Button x:Name="RetryButton" Style="{StaticResource Action}" Content="Riprova"
                                Click="RetryHome_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Action}" Content="Impostazioni" Click="Settings_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Background="#EA18212A" BorderBrush="#435563" BorderThickness="1" CornerRadius="12"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,14" Padding="5">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Action}" Width="49" Padding="12,6" Click="Windows_Click"
                            AutomationProperties.Name="Apri il desktop Windows" ToolTip="Desktop Windows">
                        <Path Width="22" Height="22" Stretch="Uniform" Fill="#96DEEB"
                              Data="M0,0 H9 V9 H0 Z M11,0 H20 V9 H11 Z M0,11 H9 V20 H0 Z M11,11 H20 V20 H11 Z"/>
                    </Button>
                    <Button Style="{StaticResource Action}" Content="Cornice" Click="Frame_Click" Margin="5,0,0,0"
                            ToolTip="Torna alla cornice fotografica" />
                    <Button Style="{StaticResource Action}" Width="49" Padding="10,6" Click="Settings_Click" Margin="5,0,0,0"
                            AutomationProperties.Name="Impostazioni" ToolTip="Impostazioni">
                        <TextBlock Text="&#x2699;" FontSize="21" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="PhotoLayer" Background="Black" ClipToBounds="True"
              PreviewTouchDown="Photo_TouchDown" MouseLeftButtonUp="Photo_MouseUp">
            <Image x:Name="BackPhoto" Stretch="UniformToFill" />
            <Image x:Name="FrontPhoto" Stretch="UniformToFill" />
            <Border x:Name="EmptyFrame" Background="#111820" Padding="32">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock Text="Surface Frame" Foreground="{StaticResource Text}" FontSize="32"
                               TextAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock x:Name="FrameStatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               TextAlignment="Center" FontSize="16" LineHeight="24" Margin="0,12,0,20" />
                    <Button Style="{StaticResource Action}" HorizontalAlignment="Center" Content="Impostazioni"
                            Click="Settings_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
